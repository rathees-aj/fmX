# fmX Global Radio — Environment Configuration Example
# Copy this file to .env or configure in Cloudflare Pages dashboard under Settings > Environment variables

# Public Client-side Configuration (Prefixed with EXPO_PUBLIC_)
# Optional custom Radio Browser API mirror (defaults to resilient round-robin community mirrors)
EXPO_PUBLIC_RADIO_BROWSER_MIRROR=https://de1.api.radio-browser.info

# Application Environment ('production', 'preview', 'development')
EXPO_PUBLIC_APP_ENV=production
