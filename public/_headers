# Global security and caching headers for fmX on Cloudflare Pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), autoplay=(self)

# HTML must revalidate to pick up new bundles immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Immutable caching for hashed static JS, CSS and media bundles
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
