{
  "expo": {
    "name": "fmX",
    "slug": "fmX",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/fmX icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "splash": {
      "image": "./assets/fmx logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fm.fmx.radio",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSLocationWhenInUseUsageDescription": "Allow fmX to use your location to discover online radio stations near you. Your location is used for nearby discovery."
      }
    },
    "android": {
      "package": "fm.fmx.radio",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/fmX icon.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow fmX to use your location to discover online radio stations near you. Your location is used for nearby discovery."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/fmX icon.png"
    }
  }
}
